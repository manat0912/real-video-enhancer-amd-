diff --git a/scripts/benchmark_upscale.py b/scripts/benchmark_upscale.py
new file mode 100644
--- /dev/null
+++ b/scripts/benchmark_upscale.py
@@ -0,0 +1,66 @@
+"""Measure warm model inference separately from decode/encode throughput."""
+import argparse
+import json
+import os
+from pathlib import Path
+import sys
+import time
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--model", required=True)
+    parser.add_argument("--width", type=int, default=640)
+    parser.add_argument("--height", type=int, default=360)
+    parser.add_argument("--frames", type=int, default=30)
+    parser.add_argument("--warmup", type=int, default=3)
+    parser.add_argument("--gpu", type=int, default=0)
+    parser.add_argument("--profile", choices=("fast", "tuned", "compatibility"), default="fast")
+    parser.add_argument("--precision", choices=("float16", "float32"), default="float16")
+    parser.add_argument("--json", dest="json_path")
+    args = parser.parse_args()
+    if min(args.width, args.height, args.frames) < 1 or args.warmup < 0:
+        parser.error("Dimensions and frame count must be positive, warmup must be nonnegative")
+    os.environ["RVE_FAST_INFERENCE"] = "1" if args.profile in ("fast", "tuned") else "0"
+    os.environ["RVE_TUNE_CONVOLUTION"] = "1" if args.profile == "tuned" else "0"
+    os.environ["RVE_USE_ACCELERATE"] = "1"
+    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "backend"))
+    import torch
+    from src.pytorch.UpscaleModelWrapper import UpscaleModelWrapper
+    from src.pytorch.Acceleration import move_to_device
+    if not torch.cuda.is_available():
+        raise RuntimeError("A working ROCm or CUDA GPU is required for this benchmark")
+    device = torch.device("cuda", args.gpu)
+    torch.cuda.set_device(device)
+    dtype = getattr(torch, args.precision)
+    startup = time.perf_counter()
+    wrapper = UpscaleModelWrapper(str(Path(args.model).resolve()), device, dtype)
+    input_frame = move_to_device(torch.rand(1, 3, args.height, args.width), device).to(dtype=wrapper.get_precision())
+    with torch.inference_mode():
+        for _ in range(args.warmup):
+            output = wrapper(input_frame)
+        torch.cuda.synchronize(device)
+        startup = time.perf_counter() - startup
+        torch.cuda.reset_peak_memory_stats(device)
+        started = time.perf_counter()
+        for _ in range(args.frames):
+            output = wrapper(input_frame)
+        torch.cuda.synchronize(device)
+        elapsed = time.perf_counter() - started
+    report = {
+        "measurement": "warm model inference only; excludes video decoding, transfers per frame, encoding and restoration/interpolation passes",
+        "gpu": torch.cuda.get_device_name(device), "torch": torch.__version__, "hip": torch.version.hip,
+        "model": Path(args.model).name, "profile": args.profile, "precision": str(wrapper.get_precision()),
+        "input": [args.width, args.height], "output": [output.shape[-1], output.shape[-2]],
+        "frames": args.frames, "startup_and_warmup_seconds": round(startup, 3),
+        "elapsed_seconds": round(elapsed, 3), "inference_fps": round(args.frames / elapsed, 2),
+        "peak_vram_gib": round(torch.cuda.max_memory_allocated(device) / 1024**3, 3),
+    }
+    content = json.dumps(report, indent=2)
+    print(content)
+    if args.json_path:
+        Path(args.json_path).write_text(content + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/check_acceleration.py b/scripts/check_acceleration.py
new file mode 100644
--- /dev/null
+++ b/scripts/check_acceleration.py
@@ -0,0 +1,49 @@
+"""Native runtime smoke test, also used by the launcher's installation step."""
+import argparse
+import importlib.metadata
+import json
+from pathlib import Path
+import sys
+
+
+def diagnose(require_rocm=False):
+    report = {"python": sys.executable, "python_version": sys.version.split()[0]}
+    try:
+        import torch
+        if not torch.cuda.is_available():
+            report["action"] = "No ROCm/CUDA GPU runtime detected. Select NCNN for Vulkan, or check the installed PyTorch build and AMD driver."
+        report.update(torch=torch.__version__, hip=torch.version.hip, gpu_available=torch.cuda.is_available())
+        if torch.cuda.is_available():
+            report["gpus"] = [{"index": i, "name": torch.cuda.get_device_name(i), "vram_gib": round(torch.cuda.get_device_properties(i).total_memory / 1024**3, 1)} for i in range(torch.cuda.device_count())]
+            # Test a real FP16 convolution, rather than only device enumeration.
+            device = torch.device("cuda", 0)
+            layer = torch.nn.Conv2d(3, 8, 3, padding=1).to(device=device, dtype=torch.float16)
+            output = layer(torch.ones(1, 3, 64, 64, device=device, dtype=torch.float16))
+            torch.cuda.synchronize(device)
+            report["fp16_convolution"] = bool(torch.isfinite(output).all().item())
+        report["accelerate"] = importlib.metadata.version("accelerate")
+        success = (not require_rocm) or bool(torch.version.hip and report.get("fp16_convolution"))
+    except Exception as error:
+        report["error"] = str(error)
+        success = False
+    if not success:
+        report["action"] = "Use Python 3.12 and supported ROCm wheels; check the AMD driver and GPU compatibility matrix."
+    print(json.dumps(report, indent=2))
+    return success
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--require-rocm", action="store_true")
+    parser.add_argument("--mark-ready", action="store_true", help="Validate ROCm and register this launcher environment")
+    args = parser.parse_args()
+    marker = Path(sys.prefix) / ".ready" if args.mark_ready else None
+    if marker is not None:
+        expected = Path(__file__).resolve().parents[1] / "env-rocm"
+        if marker.parent.resolve() != expected.resolve() or sys.prefix == sys.base_prefix:
+            parser.error("--mark-ready must use the app's env-rocm environment")
+        marker.unlink(missing_ok=True)
+    if not diagnose(args.require_rocm or args.mark_ready):
+        sys.exit(1)
+    if marker is not None:
+        marker.write_text("Native ROCm FP16 convolution passed.\n", encoding="utf-8")
