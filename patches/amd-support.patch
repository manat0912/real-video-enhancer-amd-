+"""Single-GPU inference controls shared by CUDA and native ROCm/HIP."""
+import os
+import torch
+
+
+def fast_profile():
+    return os.environ.get("RVE_FAST_INFERENCE", "0") == "1"
+
+
+def move_to_device(tensor, device):
+    if os.environ.get("RVE_USE_ACCELERATE", "0") == "1":
+        from accelerate.utils import send_to_device
+        # Use the selected GPU, including HIP's torch.cuda device interface.
+        return send_to_device(tensor, device, non_blocking=True)
+    return tensor.to(device=device, non_blocking=True)
+
+
+def configure_model(model, device):
+    if fast_profile() and device.type == "cuda":
+        # ROCm uses this PyTorch API for MIOpen convolution selection as well.
+        torch.backends.cudnn.benchmark = os.environ.get("RVE_TUNE_CONVOLUTION") == "1"
+        with torch.inference_mode(False):
+            model.to(memory_format=torch.channels_last)
+        return True
+    return False
