diff --git a/src/ui/AMDAcceleration.py b/src/ui/AMDAcceleration.py
new file mode 100644
--- /dev/null
+++ b/src/ui/AMDAcceleration.py
@@ -0,0 +1,130 @@
+"""Acceleration settings without changing Designer-generated GUI code."""
+import os
+from PySide6.QtCore import QProcess, QSettings, QUrl
+from PySide6.QtGui import QDesktopServices
+from PySide6.QtWidgets import (
+    QCheckBox, QComboBox, QDialog, QDialogButtonBox, QFormLayout,
+    QLabel, QPushButton, QSpinBox, QTextEdit, QVBoxLayout,
+)
+from ..constants import CWD, PYTHON_EXECUTABLE_PATH
+
+FSR_URL = "https://gpuopen.com/manuals/fsr_sdk/"
+DLSS_URL = "https://github.com/danielblnc/DLSS-NR-on-AMD"
+
+
+def preferences():
+    return QSettings("REAL-Video-Enhancer", "AMDAcceleration")
+
+def active_profile(settings):
+    default = "fast" if os.environ.get("RVE_DEFAULT_FAST_INFERENCE") == "1" else "compatibility"
+    return settings.value("profile", default)
+
+def use_accelerate(settings):
+    return settings.value("accelerate", os.environ.get("RVE_DEFAULT_FAST_INFERENCE") == "1", type=bool)
+
+
+def render_environment():
+    settings = preferences()
+    env = os.environ.copy()
+    profile = active_profile(settings)
+    env["RVE_FAST_INFERENCE"] = "1" if profile in ("fast", "tuned") else "0"
+    env["RVE_TUNE_CONVOLUTION"] = "1" if profile == "tuned" else "0"
+    env["RVE_USE_ACCELERATE"] = "1" if use_accelerate(settings) else "0"
+    env["RVE_QUEUE_DEPTH"] = str(settings.value("queue_depth", 8, type=int))
+    return env
+
+
+class AccelerationDialog(QDialog):
+    def __init__(self, parent):
+        super().__init__(parent)
+        self.setWindowTitle("AMD acceleration and rendering speed")
+        self.resize(650, 600)
+        self.settings = preferences()
+        layout = QVBoxLayout(self)
+        intro = QLabel("Native ROCm runs neural models on your Radeon GPU. Select pytorch (rocm) in Processing.\n"
+                       "Use Settings → h264_amf, h265_amf, or av1_amf for AMD hardware encoding.\n"
+                       "Measured render FPS depends on resolution and model; playback FPS is a separate setting.")
+        intro.setWordWrap(True)
+        layout.addWidget(intro)
+        form = QFormLayout()
+        self.profile = QComboBox()
+        self.profile.addItem("Compatibility — standard model layout", "compatibility")
+        self.profile.addItem("Fast — shorter startup, optimized image layout", "fast")
+        self.profile.addItem("Tuned — searches for faster kernels, longer startup", "tuned")
+        self.profile.setCurrentIndex(max(0, self.profile.findData(active_profile(self.settings))))
+        self.accelerate = QCheckBox("Use Hugging Face Accelerate for transfers to the selected GPU")
+        self.accelerate.setChecked(use_accelerate(self.settings))
+        self.queue_depth = QSpinBox()
+        self.queue_depth.setRange(1, 25)
+        self.queue_depth.setValue(self.settings.value("queue_depth", 8, type=int))
+        self.queue_depth.setToolTip("Bounded frame queues keep RAM and VRAM use independent of movie length.")
+        form.addRow("Inference profile", self.profile)
+        form.addRow(self.accelerate)
+        form.addRow("Frames buffered per queue", self.queue_depth)
+        layout.addLayout(form)
+        tip = QLabel("For speed: use auto/float16 precision, a compact model, and hardware encoding.\n"
+                     "Test Fast against Compatibility on a short clip. Heavy restoration passes add work.\n"
+                     "Processing's Benchmark mode measures the pipeline without saving a movie.")
+        tip.setWordWrap(True)
+        layout.addWidget(tip)
+        for title, explanation, url in (
+            ("AMD FSR upscaling 4.1", "Unavailable for video files: the SDK requires a graphics renderer with depth, motion vectors and jitter. This app supplies decoded video frames.", FSR_URL),
+            ("DLSS 5 / DLSS-NR-on-AMD", "Unavailable for video files: this repository hooks DirectX 12 games with FSR and requires your own DLSS DLL. It exposes no offline video API.", DLSS_URL),
+        ):
+            option = QPushButton(title + " — unavailable")
+            option.setEnabled(False)
+            option.setToolTip(explanation)
+            layout.addWidget(option)
+            label = QLabel(explanation)
+            label.setWordWrap(True)
+            layout.addWidget(label)
+            link = QPushButton("Read " + title + " integration requirements")
+            link.clicked.connect(lambda checked=False, target=url: QDesktopServices.openUrl(QUrl(target)))
+            layout.addWidget(link)
+        self.diagnostics = QTextEdit()
+        self.diagnostics.setReadOnly(True)
+        self.diagnostics.setPlaceholderText("Check the actual interpreter, GPU runtime, FP16 and Accelerate below.")
+        layout.addWidget(self.diagnostics)
+        self.check = QPushButton("Check GPU acceleration")
+        self.check.clicked.connect(self.check_gpu)
+        layout.addWidget(self.check)
+        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Save | QDialogButtonBox.StandardButton.Cancel)
+        buttons.accepted.connect(self.save)
+        buttons.rejected.connect(self.reject)
+        layout.addWidget(buttons)
+        self.process = None
+
+    def check_gpu(self):
+        self.check.setEnabled(False)
+        self.diagnostics.clear()
+        self.process = QProcess(self)
+        self.process.setWorkingDirectory(CWD)
+        self.process.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
+        self.process.readyReadStandardOutput.connect(lambda: self.diagnostics.insertPlainText(bytes(self.process.readAllStandardOutput()).decode("utf-8", errors="replace")))
+        self.process.finished.connect(lambda code, status: self.check.setEnabled(True))
+        self.process.errorOccurred.connect(lambda error: (self.diagnostics.append(self.process.errorString()), self.check.setEnabled(True)))
+        self.process.start(PYTHON_EXECUTABLE_PATH, [os.path.join(CWD, "scripts", "check_acceleration.py")])
+
+    def done(self, result):
+        if self.process and self.process.state() != QProcess.ProcessState.NotRunning:
+            self.process.kill()
+            self.process.waitForFinished(1000)
+        super().done(result)
+
+    def save(self):
+        self.settings.setValue("profile", self.profile.currentData())
+        self.settings.setValue("accelerate", self.accelerate.isChecked())
+        self.settings.setValue("queue_depth", self.queue_depth.value())
+        self.settings.sync()
+        self.accept()
+
+    def closeEvent(self, event):
+        if self.process and self.process.state() != QProcess.ProcessState.NotRunning:
+            self.process.kill()
+        super().closeEvent(event)
+
+
+def install_acceleration_menu(window):
+    menu = window.menuBar().addMenu("Acceleration")
+    action = menu.addAction("AMD acceleration and rendering speed…")
+    action.triggered.connect(lambda: AccelerationDialog(window).exec())
